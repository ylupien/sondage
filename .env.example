# --- Application ---
# Mot de passe de la page /admin (obligatoire)
ADMIN_PASSWORD=
# Adresse utilisée dans les liens envoyés par courriel. Derrière Cloudflare : https://sondage.exemple.com
PUBLIC_URL=http://localhost:8900
# Mettre à true quand l'application est servie en HTTPS (Cloudflare)
COOKIE_SECURE=false

# --- Courriel : RESEND_API_KEY (Resend) ou SMTP_HOST + SMTP_* (prioritaire).
# Sans aucun des deux, les liens sont seulement affichés dans l'admin et les journaux ---
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (SSL direct), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sondage <no-reply@exemple.com>"

# --- Cloudflare Tunnel (service « tunnel », profil « public ») ---
# Config et identifiants dans deploy/cloudflared/ (voir README). Pour publier :
# COMPOSE_PROFILES=public
# Production (frontend compilé) ; sans cette ligne : mode dev avec Vite HMR
# COMPOSE_FILE=docker-compose.yml
